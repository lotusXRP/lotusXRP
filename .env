Default to Coston2 but can be changed dynamically
NETWORK=Coston2

# RPC Endpoints
RPC_URL_Coston2=https://coston2-api.flare.network/ext/bc/C/rpc
RPC_URL_Coston=https://coston-api.flare.network/ext/bc/C/rpc
RPC_URL_Mainnet=https://flare-api.flare.network/ext/bc/C/rpc

# Private Key for Deployment
PRIVATE_KEY=your-private-key-here

# Contract JSON Path
CONTRACT_JSON=./artifacts/MySmartContract.json